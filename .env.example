# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The service runs fully WITHOUT any of these set — that is "fixture" mode.

# Which classifier to use: "fixture" (deterministic, no network, no key)
# or "llm" (calls a real provider). Defaults to "fixture" if unset.
TRIAGE_MODE=fixture

# Only needed when TRIAGE_MODE=llm. Never commit a real key.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Network timeout (seconds) and retry budget for the LLM call.
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# SQLite file for idempotency records.
TRIAGE_DB_PATH=triage.db
